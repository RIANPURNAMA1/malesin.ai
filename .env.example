# TikTok Developer Configuration
# Dapatkan Client Key dari https://developers.tiktok.com/ → My Apps → App Details
VITE_TIKTOK_CLIENT_KEY=your_tiktok_client_key_here

# Redirect URI harus DIDAFTARKAN di TikTok Developer Portal (App Details → Settings)
# Cocokkan dengan environment yang digunakan:
# - Local:    http://localhost:5173/auth/tiktok/callback
# - Production: https://malesin.ai/auth/tiktok/callback
# Jika tidak diset, akan otomatis menggunakan window.location.origin
VITE_TIKTOK_REDIRECT_URI=
